<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <IsAotCompatible>true</IsAotCompatible>
    <EnablePackageValidation>true</EnablePackageValidation>

    <!-- The test and benchmark projects need internals. Released builds must not ship the
         attribute: the assembly is unsigned, so any assembly can assume those names and
         reach internals. CI passes -p:ExposeInternalsToTests=false when packing. -->
    <ExposeInternalsToTests Condition="'$(ExposeInternalsToTests)' == ''">true</ExposeInternalsToTests>

    <!-- Belt and braces for the two pack paths a property can still fix. _IsPacking is set by
         `dotnet pack` and by nothing else (the SDK says so itself at
         Microsoft.NET.Sdk.DefaultItems.targets:173); GeneratePackageOnBuild packs as part of the
         build. Both run before the compile, so flipping the property there means the assembly is
         built without the attribute in the first place. `msbuild -t:Pack`, Visual Studio's Pack
         command and an explicit -p:ExposeInternalsToTests=true global property reach neither
         condition, and by the time Pack runs the assembly is already compiled — flipping the
         property then would ship a DLL that still carries the attributes. The
         RefuseToPackWithInternalsExposed target below is what stops those. CI and the publish
         workflow pass -p:ExposeInternalsToTests=false explicitly as well. -->
    <ExposeInternalsToTests Condition="'$(_IsPacking)' == 'true' Or '$(GeneratePackageOnBuild)' == 'true'">false</ExposeInternalsToTests>

    <!-- NuGet Package Metadata -->
    <PackageId>LiteDocumentStore</PackageId>
    <Title>LiteDocumentStore</Title>
    <Authors>idotta</Authors>
    <Description>A high-performance, single-file application data format using C# and SQLite. Stores JSON data in SQLite's JSONB format for optimal performance. Native AOT / trimming compatible.</Description>
    <PackageTags>sqlite;jsonb;json;database;repository;async;document-store;aot</PackageTags>
    <PackageProjectUrl>https://github.com/idotta/lite-doc-store</PackageProjectUrl>
    <RepositoryUrl>https://github.com/idotta/lite-doc-store</RepositoryUrl>
    <RepositoryType>git</RepositoryType>
    <PackageLicenseExpression>MIT</PackageLicenseExpression>
    <PackageReadmeFile>README.md</PackageReadmeFile>
    <PackageIcon>litedocstore-icon.png</PackageIcon>
    <PackageRequireLicenseAcceptance>false</PackageRequireLicenseAcceptance>
    <PublishRepositoryUrl>true</PublishRepositoryUrl>
    <EmbedUntrackedSources>true</EmbedUntrackedSources>
    <IncludeSymbols>true</IncludeSymbols>
    <SymbolPackageFormat>snupkg</SymbolPackageFormat>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.Data.Sqlite" />
    <PackageReference Include="SQLitePCLRaw.lib.e_sqlite3" />
    <PackageReference Include="SQLitePCLRaw.core" />
    <PackageReference Include="Microsoft.Extensions.DependencyInjection.Abstractions" />
    <PackageReference Include="Microsoft.Extensions.Logging.Abstractions" />
    <PackageReference Include="Microsoft.SourceLink.GitHub" PrivateAssets="All" />
  </ItemGroup>

  <ItemGroup>
    <None Include="../../README.md" Pack="true" PackagePath="\" />
    <None Include="../../litedocstore-icon.png" Pack="true" PackagePath="\" />
  </ItemGroup>

  <ItemGroup Condition="'$(ExposeInternalsToTests)' == 'true'">
    <InternalsVisibleTo Include="LiteDocumentStore.Benchmarks" />
    <InternalsVisibleTo Include="LiteDocumentStore.IntegrationTests" />
    <InternalsVisibleTo Include="LiteDocumentStore.UnitTests" />
  </ItemGroup>

  <!-- The backstop for every pack path the property conditions above cannot reach. The assembly
       is unsigned, so a shipped InternalsVisibleTo lets any assembly claiming a test project's
       name reach internals; refusing the pack is the only honest answer once the compile is
       already done. GenerateNuspec is named alongside Pack deliberately: Pack runs *after* the
       targets that write the .nupkg, so hooking it alone fails the build but still leaves a
       leaky package sitting on disk for someone to push. -->
  <Target Name="RefuseToPackWithInternalsExposed"
          BeforeTargets="Pack;GenerateNuspec"
          Condition="'$(ExposeInternalsToTests)' == 'true'">
    <Error Code="LDS0001"
           Text="Refusing to pack: ExposeInternalsToTests is 'true', so the package would ship InternalsVisibleTo attributes for the test and benchmark projects into an unsigned assembly. Pass -p:ExposeInternalsToTests=false to pack." />
  </Target>

</Project>
