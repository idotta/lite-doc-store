<Project>

  <PropertyGroup>
    <ManagePackageVersionsCentrally>true</ManagePackageVersionsCentrally>
    <CentralPackageTransitivePinningEnabled>true</CentralPackageTransitivePinningEnabled>
  </PropertyGroup>

  <!-- Runtime: SQLite data access + the pinned native binary -->
  <ItemGroup>
    <PackageVersion Include="Microsoft.Data.Sqlite" Version="10.0.9" />
    <!-- Pinned to a build with patched SQLite (>=3.50.2) to clear NU1903 / CVE-2025-6965:
         Microsoft.Data.Sqlite still pulls the vulnerable SQLitePCLRaw.lib.e_sqlite3 2.1.11
         transitively. Native bundle only (no managed deps), so the 2.x managed layer stays
         intact and it remains Native-AOT compatible. Benchmarks mirror this same pin.

         The ID is deprecated ("Legacy", alternate SourceGear.sqlite3) and unlisted from 3.50.3
         on, and it is kept deliberately: the override only works because it shares the ID of
         the vulnerable transitive package. Referencing SourceGear.sqlite3 instead leaves
         SQLitePCLRaw.lib.e_sqlite3 2.1.11 in the graph and NU1903 comes back (measured), and
         both packages ship the same runtimes/<rid>/native/e_sqlite3 asset, so they cannot both
         be referenced. Moving off it means taking the whole SQLitePCLRaw 3.x chain
         (bundle -> config.e_sqlite3 + SQLite + managed core 3.x) under a Microsoft.Data.Sqlite
         built against core 2.1.x — a migration with its own validation, not a pin swap. -->
    <PackageVersion Include="SQLitePCLRaw.lib.e_sqlite3" Version="3.50.3" />
  </ItemGroup>

  <!-- DI / logging -->
  <ItemGroup>
    <PackageVersion Include="Microsoft.Extensions.DependencyInjection" Version="10.0.9" />
    <PackageVersion Include="Microsoft.Extensions.DependencyInjection.Abstractions" Version="10.0.11" />
    <PackageVersion Include="Microsoft.Extensions.Logging.Abstractions" Version="10.0.11" />
  </ItemGroup>

  <!-- Build / packaging tooling -->
  <ItemGroup>
    <PackageVersion Include="Microsoft.SourceLink.GitHub" Version="10.0.300" />
  </ItemGroup>

  <!-- Test -->
  <ItemGroup>
    <PackageVersion Include="Bogus" Version="35.6.5" />
    <PackageVersion Include="coverlet.collector" Version="10.0.1" />
    <PackageVersion Include="Microsoft.NET.Test.Sdk" Version="18.7.0" />
    <PackageVersion Include="Moq" Version="4.20.72" />
    <PackageVersion Include="xunit" Version="2.9.3" />
    <PackageVersion Include="xunit.runner.visualstudio" Version="3.1.5" />
  </ItemGroup>

  <!-- Benchmark-only: comparison baselines, not library dependencies -->
  <ItemGroup>
    <PackageVersion Include="BenchmarkDotNet" Version="0.15.8" />
    <PackageVersion Include="BenchmarkDotNet.Diagnostics.Windows" Version="0.15.8" />
    <PackageVersion Include="Dapper" Version="2.1.79" />
    <PackageVersion Include="LiteDB" Version="5.0.21" />
  </ItemGroup>

</Project>
